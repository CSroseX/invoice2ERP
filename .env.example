# invoice2ERP - Environment Configuration Template
# Duplicate this file as .env and fill in your API keys.

# 1. Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 3. OpenRouter API Configuration
OPEN_ROUTER_API=your_openrouter_api_key_here
OPEN_ROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# 4. Cloudflare Workers AI Configuration
CLOUDFLARE_WORKERS_AI=your_cloudflare_api_key_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
